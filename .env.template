NODE_ENV=production

# Client-side variables
NEXT_PUBLIC_APP_URL=https://dev.chorus-tre.ch
NEXT_PUBLIC_API_URL=https://backend.dev.chorus-tre.ch
NEXT_PUBLIC_API_SUFFIX=/api/rest/v1
NEXT_PUBLIC_MATOMO_URL=https://matomo.dev.chorus-tre.ch
NEXT_PUBLIC_MATOMO_CONTAINER_ID=XHnjFrGP
NEXT_PUBLIC_MATOMO_SITE_ID=1

# Delay (ms) before a session iframe is considered ready; 0 disables the delay
NEXT_PUBLIC_SESSION_READY_DELAY_MS=0

# In-platform assistant (demo feature) - disabled unless set to "true"
NEXT_PUBLIC_ENABLE_AGENT=false

# Which Xpra HTML5 client a session embeds:
#   "local"  - the copy vendored in public/vendor/xpra, same origin, with the
#              window.chorusXpra bridge (window list / focus / resize)
#   anything else (default) - the client served by the session pod, cross-origin,
#              no bridge: no click-to-switch, no resize fix
NEXT_PUBLIC_XPRA_CLIENT=local

# Server side 
LLM_API_BASE_URL=https://[IP_ADDRESS]/v1/
LLM_API_KEY=[api-key]
LLM_API_MODEL=[model]